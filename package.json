{
  "name": "drum-coach",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:server\"",
    "server": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc && vite build",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "playtest": "node scripts/playtest/run.mjs",
    "deps:check": "node scripts/check-deps.mjs --all",
    "mobile:test": "cd apps/mobile && (npm ls --depth=0 >/dev/null 2>&1 || npm ci) && npm run typecheck && npm test && npm run check:versions",
    "typecheck": "tsc -p .",
    "test:coverage": "vitest run --coverage",
    "audit:deps": "npm audit --audit-level=low && npm audit signatures",
    "check": "npm run deps:check && npm run audit:deps && npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run mobile:test",
    "hooks:install": "git config core.hooksPath .githooks && echo \"Git hooks on: secret check before each commit, npm run check before each push.\""
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/rate-limit": "^11.2.1",
    "@tonejs/midi": "^2.0.28",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vexflow": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
