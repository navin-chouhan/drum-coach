# Optional: only for the API fallback. The default coach uses your logged-in `claude` CLI.
ANTHROPIC_API_KEY=
# YouTube song search (free): see README → YouTube setup.
YOUTUBE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Set AI_PROVIDER=api to use the key above instead of the claude CLI.
AI_PROVIDER=
# Optional: model for the claude CLI provider (default: your Claude Code default).
CLAUDE_CLI_MODEL=
# Optional: where SQLite + uploaded audio live (default ./data).
DATA_DIR=
PORT=8787
# Optional: Piper voice for the coach (default: first .onnx in data/voices)
PIPER_VOICE=
