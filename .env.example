# Optional: only for the API fallback. The default coach uses your logged-in `claude` CLI.
ANTHROPIC_API_KEY=
# YouTube song search (free): see README → YouTube setup.
YOUTUBE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Set AI_PROVIDER=api to use the key above instead of the claude CLI.
AI_PROVIDER=
# Model and effort for the claude CLI provider (default: your Claude Code defaults).
# claude-haiku-5-5 + low = fastest answers; claude-sonnet-5-5 / opus for deeper coaching.
CLAUDE_CLI_MODEL=claude-haiku-5-5
CLAUDE_CLI_EFFORT=low
# Lessons, plans, show-off picks and song grooves are written in the background by a stronger model
# (default claude-sonnet-5-5 on medium effort); the live chat above stays fast.
CLAUDE_CLI_LESSON_MODEL=claude-sonnet-5-5
CLAUDE_CLI_LESSON_EFFORT=medium
# Optional: where SQLite + uploaded audio live (default ./data).
DATA_DIR=
PORT=8787
# Optional: Piper voice for the coach (default: first .onnx in data/voices)
PIPER_VOICE=
# Home-server mode (the iPad app reaches this server over the LAN or Tailscale): docs/mobile/HOME-SERVER.md.
# Leave all three empty and the API stays on this machine only, as before.
# APP_HOST: where to listen (default 127.0.0.1). 0.0.0.0 = every interface (the web app on this machine keeps working).
APP_HOST=
# APP_TOKEN: the iPad's key, at least 24 characters (openssl rand -base64 32). The server won't start on a non-loopback
# APP_HOST without it. The iPad sends it as `Authorization: Bearer <token>`. Never commit it.
APP_TOKEN=
# ALLOWED_HOSTS: the address or name the iPad uses to reach this machine, comma-separated (e.g. 192.168.1.20,my-mac.tailnet.ts.net).
ALLOWED_HOSTS=
