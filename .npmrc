# Supply-chain hardening for every npm command in this repo (README → Security and quality checks).
# scripts/check-deps.mjs enforces the same rules on the lockfile, so they hold even on an older npm.

# Never run dependencies' install scripts: that's how a hijacked package runs code on your laptop. Nothing here needs
# them (better-sqlite3 ships prebuilt binaries). `npm run …` still works.
ignore-scripts=true
# Only versions published at least 7 days ago (npm 11.10+): bad releases are usually caught and pulled by then.
min-release-age=7
# Registry packages only: no git or tarball-URL dependencies (npm 11.10+; the default from npm 12).
allow-git=none
allow-remote=none
registry=https://registry.npmjs.org/
# Refuse to install on a Node that package.json "engines" (or a dependency) doesn't support.
engine-strict=true
