{
  "name": "drum-coach-mobile",
  "version": "0.1.0",
  "description": "Drum Coach for iPad: Expo dev build that runs @drum-coach/core (packages/core). Its own npm project, not a root workspace (React Native needs Expo's exact React).",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "npx --yes expo-doctor@1.21.5",
    "check:versions": "node ../../scripts/check-expo-versions.mjs .",
    "gen:prompts": "node scripts/gen-coach-prompts.mjs"
  },
  "dependencies": {
    "@drum-coach/core": "file:../../packages/core",
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "58.0.15",
    "@tonejs/midi": "^2.0.28",
    "expo": "58.0.17",
    "expo-constants": "58.0.13",
    "expo-dev-client": "58.0.14",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.10",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.25",
    "expo-secure-store": "58.0.2",
    "expo-speech": "58.0.3",
    "expo-splash-screen": "58.0.11",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "vexflow": "5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "node-forge": "1.4.2"
  }
}
