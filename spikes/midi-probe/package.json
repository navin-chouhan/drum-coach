{
  "name": "drum-coach-midi-probe",
  "version": "0.1.0",
  "description": "Gate 0 MIDI spike: proves the MPS-150 delivers correct, well-timed MIDI into an Expo dev build on iPad/iPhone",
  "main": "index.ts",
  "dependencies": {
    "expo": "58.0.20",
    "expo-clipboard": "58.0.4",
    "expo-dev-client": "58.0.16",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild --platform ios --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctor": "expo-doctor"
  },
  "private": true
}
