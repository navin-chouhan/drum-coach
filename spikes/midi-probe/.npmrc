# The same supply-chain rules as the repo root's .npmrc (npm reads the .npmrc next to the package.json it runs in,
# so the root file doesn't apply here). scripts/check-deps.mjs checks this lockfile against spikes/midi-probe/deps-allow.json.

# Never run dependencies' install scripts. (See apps/mobile/.npmrc for why each line is here.)
ignore-scripts=true
# Only versions published at least 7 days ago (npm 11.10+). On an older npm, install with --before=<a date 7 days ago>.
min-release-age=7
# Registry packages only: no git or tarball-URL dependencies (npm 11.10+).
allow-git=none
